# Copy this file to .env and enter your Safepay SANDBOX credentials.
# Do not put secret keys in index.html or script.js or commit .env.
PORT=3000
SITE_URL=http://localhost:3000
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=your_sandbox_public_api_key
SAFEPAY_SECRET_KEY=your_sandbox_secret_key
SAFEPAY_WEBHOOK_SECRET=your_sandbox_webhook_hmac_secret
